# Скопируйте в .env и при необходимости измените:
#   copy .env.example .env

HOST_PORT=8000
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=замените-на-случайную-длинную-строку

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,.ngrok-free.dev,.ngrok.io,uncoddled-miquel-wabbly.ngrok-free.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://uncoddled-miquel-wabbly.ngrok-free.dev

# Если ngrok выдал новый поддомен — добавьте его в оба списка (без пробелов после запятой).
